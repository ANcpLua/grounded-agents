<?xml version="1.0" encoding="utf-8"?>
<!--
  ANcpLua.Agents.Evaluation is vendored source compiled into the same assembly. It is owned and
  tested upstream and must not be edited here, so it is excluded by namespace instead of by
  attribute.
-->
<Configuration>
  <CodeCoverage>
    <Functions>
      <Exclude>
        <Function>^ANcpLua\.Agents\.Evaluation\..*</Function>
      </Exclude>
    </Functions>
  </CodeCoverage>
</Configuration>
